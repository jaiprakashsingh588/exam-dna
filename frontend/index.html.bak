<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>ExamDNA</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            max-width: 1100px;
            margin: 40px auto;
            padding: 20px;
            background: #f5f7fb;
        }
        h1 { margin-bottom: 5px; }
        .subtitle { color: #666; }
        .cards {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin: 30px 0;
        }
        .card {
            background: white;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 2px 8px #ddd;
        }
        .number {
            font-size: 28px;
            font-weight: bold;
        }
        pre {
            background: #111827;
            color: #e5e7eb;
            padding: 20px;
            border-radius: 10px;
            overflow: auto;
        }
    </style>
</head>
<body>

<h1>ExamDNA</h1>
<div class="subtitle">GATE Exam Intelligence Engine</div>

<div class="cards">
    <div class="card">
        <div>Total Questions</div>
        <div class="number" id="total">-</div>
    </div>
    <div class="card">
        <div>2026 Questions</div>
        <div class="number" id="y2026">-</div>
    </div>
    <div class="card">
        <div>2025 Questions</div>
        <div class="number" id="y2025">-</div>
    </div>
    <div class="card">
        <div>MCQ Questions</div>
        <div class="number" id="mcq">-</div>
    </div>
</div>

<h2>PYQ Search</h2>

<div style="background:white;padding:20px;border-radius:12px;margin-bottom:25px;">
    <select id="year">
        <option value="">All Years</option>
        <option value="2026">2026</option>
        <option value="2025">2025</option>
        <option value="2010">2010</option>
    </select>

    <select id="type">
        <option value="">All Types</option>
        <option value="MCQ">MCQ</option>
        <option value="MSQ">MSQ</option>
        <option value="NAT">NAT</option>
    </select>

    <button onclick="searchQuestions()">Search</button>
</div>

<div id="results"></div>

<h2>Question Intelligence</h2>
<pre id="stats">Loading...</pre>

<script>
async function loadStats() {
    const response = await fetch("/questions/stats");
    const data = await response.json();

    document.getElementById("total").textContent = data.total_questions;
    document.getElementById("y2026").textContent = data.by_year["2026"] || 0;
    document.getElementById("y2025").textContent = data.by_year["2025"] || 0;
    document.getElementById("mcq").textContent = data.by_question_type["MCQ"] || 0;

    document.getElementById("stats").textContent =
        JSON.stringify(data, null, 2);
}

async function searchQuestions() {
    const year = document.getElementById("year").value;
    const type = document.getElementById("type").value;

    let url = "/questions/search?limit=20";

    if (year) url += "&year=" + year;
    if (type) url += "&question_type=" + type;

    const response = await fetch(url);
    const data = await response.json();

    document.getElementById("results").innerHTML =
        "<p><b>" + data.count + "</b> matching questions</p>" +
        data.questions.map(q =>
            "<div class='card' style='margin-bottom:12px;'>" +
            "<b>" + q.year + " · " + q.question_type + "</b><br>" +
            q.question_text +
            "</div>"
        ).join("");
}

loadStats();
</script>

</body>
</html>
